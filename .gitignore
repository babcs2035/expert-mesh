.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

.env
# A trailing-slash directory pattern (`data/`) cannot be selectively
# un-ignored per file by git, so this uses `data/*` instead: MANIFEST.md
# records sha256 hashes + generation commands for the otherwise-untracked
# data/ artifacts (docs/d0003 F5) and is the one file under data/ meant to
# be reproducible from git alone.
data/*
!data/MANIFEST.md
results/
# E6 supervised_classifier artifacts (scripts/train_domain_classifier.py's
# output) and E7 whitening artifacts (scripts/fit_embedding_whitening.py's
# output): generated locally, not committed, same as data/ and results/.
models/
config/embedding_whitening.json

# research-cycle の実行時メタデータ（セッション固有・共有しない）
# journal.md / state.json / backlog.md / config.yml は研究の一次記録なので追跡する
.claude/settings.local.json
.claude/research/agent.json
.claude/research/model_mode
.claude/research/.watchdog_*
